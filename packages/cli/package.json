{
  "name": "sessionforge-cli",
  "version": "0.1.0",
  "description": "Discover, classify, and safely clean up agent coding sessions (Claude Code, Codex, Gemini CLI, OpenCode, Aider) — as a CLI or as a library. No Paseo dependency.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "sessionforge": "./src/cli/run.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "cli": "tsx ./src/cli/bin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
