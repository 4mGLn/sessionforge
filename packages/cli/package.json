{
  "name": "sessionforge-cli",
  "version": "0.1.0",
  "description": "Discover, classify, and safely clean up agent coding sessions (Claude Code, Codex, Gemini CLI, OpenCode, Aider) — as a CLI or as a library. No Paseo dependency.",
  "license": "MIT",
  "author": "aMgLn",
  "repository": {
    "type": "git",
    "url": "https://github.com/4mGLn/sessionforge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/4mGLn/sessionforge/tree/main/packages/cli#readme",
  "bugs": "https://github.com/4mGLn/sessionforge/issues",
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "aider",
    "agent",
    "session-management",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "sessionforge": "./src/cli/run.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/cli",
    "src/core",
    "src/index.ts",
    "!src/core/**/*.test.ts",
    "!src/**/.omc",
    "!src/**/.omc/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "node scripts/build-binary.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "tsx ./src/cli/bin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
