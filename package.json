{
  "name": "sessionforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspace packages/cli",
    "build": "npm run build --workspace packages/cli",
    "test": "npm test --workspace packages/cli",
    "cli": "npm run cli --workspace packages/cli --"
  },
  "dependencies": {
    "sessionforge-cli": "*"
  },
  "devDependencies": {
    "@getpaseo/client": "^0.4.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
